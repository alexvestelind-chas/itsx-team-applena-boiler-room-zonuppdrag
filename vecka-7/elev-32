## zonvakt.te Fil

policy_module(zonvakt, 1.0.0)    # Skapar policyn zonvakt

type zonvakt_t;                  # Typen som zonvakt körs som

type zonvakt_exec_t;             # Typ för zonvakts programfil

init_daemon_domain(zonvakt_t, zonvakt_exec_t)    # Startar zonvakt som zonvakt_t

type zonvakt_log_t;              # Typ för zonvakts loggfiler

logging_log_file(zonvakt_log_t)  # Talar om att det är loggfiler

allow zonvakt_t self:fifo_file rw_fifo_file_perms;   # Får läsa och skriva FIFO-filer

allow zonvakt_t self:unix_stream_socket create_stream_socket_perms;   # Får använda unix-sockets

allow zonvakt_t self:tcp_socket { accept bind create listen setopt read write };  # Får använda nätverket

corenet_tcp_bind_generic_node(zonvakt_t)   # Får ansluta till nätverket

corenet_tcp_bind_generic_port(zonvakt_t)   # Får använda portar

corecmd_mmap_bin_files(zonvakt_t)          # Får använda programfiler

manage_dirs_pattern(zonvakt_t, zonvakt_log_t, zonvakt_log_t)   # Får skapa loggmappar

manage_files_pattern(zonvakt_t, zonvakt_log_t, zonvakt_log_t)  # Får skapa och ändra loggfiler

manage_lnk_files_pattern(zonvakt_t, zonvakt_log_t, zonvakt_log_t)  # Får hantera länkar

logging_log_filetrans(zonvakt_t, zonvakt_log_t, { dir file lnk_file })   # Nya loggfiler får rätt typ

domain_use_interactive_fds(zonvakt_t)   # Får använda terminalens filbeskrivare

files_read_etc_files(zonvakt_t)         # Får läsa filer i /etc

miscfiles_read_localization(zonvakt_t)  # Får läsa språkfiler

allow zonvakt_t self:tcp_socket { accept bind create getattr listen setopt };   # Får använda TCP

auth_read_passwd_file(zonvakt_t)        # Får läsa passwd-filen

sssd_read_public_files(zonvakt_t)       # Får läsa publika SSSD-filer

sssd_search_lib(zonvakt_t)              # Får använda SSSD-bibliotek

